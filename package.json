    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^3.2.7"
